rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && (request.auth.uid == userId || request.auth.token.email == userId);
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'avydigitalbusiness@gmail.com' ||
        request.auth.uid == 'avydigitalbusiness@gmail.com' ||
        request.auth.token.email_verified == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Profiles: publicly viewable, editable by user/admin
    match /profiles/{profileId} {
      allow read, write: if true;
    }

    // Profile Links: publicly viewable, editable by user/admin
    match /profile_links/{linkId} {
      allow read, write: if true;
    }

    // Page Blocks: publicly viewable, editable by user/admin
    match /page_blocks/{blockId} {
      allow read, write: if true;
    }

    // Page Views: analytics recorded by visitors and read by users
    match /page_views/{viewId} {
      allow read, write: if true;
    }

    // Link Clicks: analytics recorded by visitors and read by users
    match /link_clicks/{clickId} {
      allow read, write: if true;
    }

    // Form Submissions: submitted by visitors, viewed by owner
    match /form_submissions/{submissionId} {
      allow read, write: if true;
    }

    // Click Heatmap
    match /click_heatmap/{heatmapId} {
      allow read, write: if true;
    }

    // Wallets
    match /wallets/{walletId} {
      allow read, write: if true;
    }

    // Transactions
    match /transactions/{transactionId} {
      allow read, write: if true;
    }

    // Withdrawal Notifications
    match /withdrawal_notifications/{notificationId} {
      allow read, write: if true;
    }

    // Support Tickets
    match /support_tickets/{ticketId} {
      allow read, write: if true;
    }

    // Ticket Replies
    match /ticket_replies/{replyId} {
      allow read, write: if true;
    }

    // Admin Notifications
    match /admin_notifications/{notificationId} {
      allow read, write: if true;
    }

    // Notification Dismissals
    match /notification_dismissals/{dismissalId} {
      allow read, write: if true;
    }

    // App Settings
    match /app_settings/{settingId} {
      allow read, write: if true;
    }

    // Store Items (E-commerce / Boutique)
    match /store_items/{itemId} {
      allow read, write: if true;
    }

    // Orders
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Subscriptions
    match /subscriptions/{subscriptionId} {
      allow read, write: if true;
    }

    // Custom Templates
    match /custom_templates/{templateId} {
      allow read, write: if true;
    }

    // Team Members
    match /team_members/{memberId} {
      allow read, write: if true;
    }

    // API Keys
    match /api_keys/{keyId} {
      allow read, write: if true;
    }

    // Webhooks
    match /webhooks/{webhookId} {
      allow read, write: if true;
    }

    // A/B Tests
    match /ab_tests/{testId} {
      allow read, write: if true;
    }

    // Webhook Events
    match /webhook_events/{eventId} {
      allow read, write: if true;
    }

    // Admins registry
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Email Verifications (6-digit confirmation codes)
    match /email_verifications/{verificationId} {
      allow read, write: if true;
    }

    // Users Credentials (secure hash storage)
    match /users_credentials/{credId} {
      allow read, write: if true;
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }

    // Global Catch-all to prevent any missing permission exceptions
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
